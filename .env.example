# Postgres connection. Tables live in the `scheduling` schema; the database can be shared with other apps.
# For Supabase use the "Direct connection" or "Session pooler" string from Project Settings -> Database.
# No ?schema= parameter needed: the app always uses the `scheduling` schema by name. URL-encode special
# characters in the password.
DATABASE_URL=postgres://scheduling:scheduling@localhost:5439/scheduling

# Public URL of this app (used in booking links, OAuth redirects). No trailing slash.
APP_URL=http://localhost:3000

# Random 32+ char secret for session signing. `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# 32-byte key (base64) used to encrypt Google refresh tokens at rest. `openssl rand -base64 32`
ENCRYPTION_KEY=change-me-to-a-32-byte-base64-key

# Google OAuth client (Web application). Authorized redirect URIs:
#   {APP_URL}/api/google/callback        (connecting calendars)
#   {APP_URL}/api/auth/callback/google   (optional "Sign in with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to "true" to allow "Sign in with Google" on the login page (requires the client above).
GOOGLE_LOGIN_ENABLED=false

# "google" (default) talks to Google Calendar. "none" skips all calendar calls (local dev / demos).
CALENDAR_PROVIDER=google

# Set to "true" to lock the instance to one account: the first signup creates the admin, after which
# every signup path (including new accounts via "Sign in with Google") is disabled.
SINGLE_USER=false
